# Copiar a .env.secrets.local (gitignored) y completar valores.
# Usar con: supabase secrets set --env-file .env.secrets.local

# ─── Google Gemini — Único proveedor de IA del CRM WhatsApp ──────────────
# Gemini 3.6 Flash es el modelo recomendado:
#   https://ai.google.dev/gemini-api/docs/models/gemini-3.6-flash
# Fallback si la API key no tiene 3.6: gemini-3.5-flash
GEMINI_API_KEY=
GEMINI_MODEL_REPLY=gemini-3.6-flash
GEMINI_MODEL_JSON=gemini-3.6-flash
GEMINI_MODEL_TRANSCRIBE=gemini-3.6-flash

# ─── WhatsApp / Meta ─────────────────────────────────────────────────────
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=1035566289641219
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
ENABLE_META_SEND=true
WHATSAPP_WEBHOOK_MODE=active
META_GRAPH_API_VERSION=v21.0

# ─── OPS V5 — visitas y automatización (no inventar valores comerciales) ─
# Alerta “Atención hoy”. Sin estos secretos la visita se guarda, el WABA no sale.
VISITS_ALERT_PHONE=
USER_CONSOLE_URL=
# Nivel 1 (sugerencia) es el default. No poner 2/3 sin aprobación explícita.
OPS_V5_AUTOMATION_LEVEL=1
OPS_V5_AUTOMATION_LEVEL_2_APPROVED=false
OPS_V5_AUTOMATION_LEVEL_3_APPROVED=false
# Laboral / comercial: dejar vacío hasta que Oscar/comercial confirmen.
OPS_V5_LABOR_HOURLY_COP=
OPS_V5_LABOR_DAILY_FLOOR_COP=
OPS_V5_EMPLOYER_COST_MULTIPLIER=
OPS_V5_TRANSPORT_PER_VISIT_COP=
OPS_V5_LABOR_CONFIG_VERSION=
OPS_V5_TRAVEL_FALLBACK_URBAN_KMH=
OPS_V5_TRAVEL_MINIMUM_FALLBACK_MINUTES=
OPS_V5_ENGINE_WEIGHTS=
