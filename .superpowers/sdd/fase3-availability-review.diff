+import { HttpsError } from 'firebase-functions/v2/https';
+import { PROSAVIS_LIMPIEZA_SERVICE_ID } from '../constants/pricing';
+import {
+  handleCrmGetAvailableSlots,
+  validateCrmAvailabilityRequest,
+} from './crmGetAvailableSlots';
+
+const VALID_BODY = {
+  startDate: '2026-08-06',
+  endDate: '2026-08-12',
+  duration: 240,
+};
+
+describe('validateCrmAvailabilityRequest', () => {
+  test('accepts the seven-day inclusive horizon and every official duration', () => {
+    for (const duration of [120, 180, 240, 360, 480]) {
+      expect(validateCrmAvailabilityRequest({
+        ...VALID_BODY,
+        duration,
+      })).toEqual({
+        ...VALID_BODY,
+        duration,
+      });
+    }
+  });
+
+  test.each([
+    [{ ...VALID_BODY, startDate: '2026-8-06' }, 'startDate'],
+    [{ ...VALID_BODY, startDate: '2026-02-30' }, 'startDate'],
+    [{ ...VALID_BODY, endDate: '2026-08-05' }, 'endDate'],
+    [{ ...VALID_BODY, endDate: '2026-08-13' }, '7 d├¡as'],
+    [{ ...VALID_BODY, duration: 60 }, 'duration'],
+    [{ ...VALID_BODY, serviceId: 'attacker-service' }, 'serviceId'],
+    [{ ...VALID_BODY, providerId: 'attacker-provider' }, 'providerId'],
+  ])('rejects invalid or caller-controlled request %#', (body, message) => {
+    expect(() => validateCrmAvailabilityRequest(body)).toThrow(message);
+  });
+});
+
+describe('handleCrmGetAvailableSlots', () => {
+  test('requires POST and the bridge secret', async () => {
+    const getAvailableSlots = jest.fn();
+
+    await expect(handleCrmGetAvailableSlots(
+      { method: 'GET', secretHeader: 'bridge-secret', body: VALID_BODY },
+      { expectedSecret: 'bridge-secret', getAvailableSlots },
+    )).resolves.toMatchObject({ status: 405 });
+
+    await expect(handleCrmGetAvailableSlots(
+      { method: 'POST', secretHeader: 'wrong-secret', body: VALID_BODY },
+      { expectedSecret: 'bridge-secret', getAvailableSlots },
+    )).resolves.toEqual({
+      status: 401,
+      body: { error: 'unauthorized' },
+    });
+
+    expect(getAvailableSlots).not.toHaveBeenCalled();
+  });
+
+  test('fixes the service and entire-team mode, then returns only real ISO slots', async () => {
+    const getAvailableSlots = jest.fn().mockResolvedValue({
+      slots: [
+        { dateTime: '2026-08-06T12:00:00.000Z', isAvailable: true },
+        { dateTime: 'invalid', isAvailable: true },
+        { dateTime: '2026-08-06T13:00:00.000Z', isAvailable: false },
+        { dateTime: '2026-08-06T14:00:00.000Z', isAvailable: true },
+      ],
+    });
+
+    const result = await handleCrmGetAvailableSlots(
+      { method: 'POST', secretHeader: 'bridge-secret', body: VALID_BODY },
+      { expectedSecret: 'bridge-secret', getAvailableSlots },
+    );
+
+    expect(getAvailableSlots).toHaveBeenCalledWith({
+      serviceId: PROSAVIS_LIMPIEZA_SERVICE_ID,
+      startDate: VALID_BODY.startDate,
+      endDate: VALID_BODY.endDate,
+      duration: VALID_BODY.duration,
+      checkEntireTeam: true,
+    });
+    expect(result).toEqual({
+      status: 200,
+      body: {
+        slots: [
+          '2026-08-06T12:00:00.000Z',
+          '2026-08-06T14:00:00.000Z',
+        ],
+      },
+    });
+  });
+
+  test('maps known client errors to 4xx and hides internal failures', async () => {
+    const notFound = jest.fn().mockRejectedValue(
+      new HttpsError('not-found', 'Servicio no encontrado'),
+    );
+    await expect(handleCrmGetAvailableSlots(
+      { method: 'POST', secretHeader: 'bridge-secret', body: VALID_BODY },
+      { expectedSecret: 'bridge-secret', getAvailableSlots: notFound },
+    )).resolves.toEqual({
+      status: 404,
+      body: { error: 'Servicio no encontrado' },
+    });
+
+    const failure = jest.fn().mockRejectedValue(new Error('sensitive failure'));
+    await expect(handleCrmGetAvailableSlots(
+      { method: 'POST', secretHeader: 'bridge-secret', body: VALID_BODY },
+      { expectedSecret: 'bridge-secret', getAvailableSlots: failure },
+    )).resolves.toEqual({
+      status: 500,
+      body: { error: 'internal' },
+    });
+  });
+});
diff --git a/functions/src/calendar/crmGetAvailableSlots.ts b/functions/src/calendar/crmGetAvailableSlots.ts
new file mode 100644
index 0000000..b62dff7
--- /dev/null
+++ b/functions/src/calendar/crmGetAvailableSlots.ts
@@ -0,0 +1,197 @@
+import { createHash, timingSafeEqual } from 'crypto';
+import { logger } from 'firebase-functions/v2';
+import { HttpsError, onRequest } from 'firebase-functions/v2/https';
+import { defineSecret } from 'firebase-functions/params';
+import { PROSAVIS_LIMPIEZA_SERVICE_ID } from '../constants/pricing';
+import { GetAvailableSlotsParams } from '../types/calendar';
+import { getAvailableSlotsInternal } from './getAvailableSlots';
+
+const firebaseCrmBridgeSecret = defineSecret('FIREBASE_CRM_BRIDGE_SECRET');
+const OFFICIAL_DURATIONS = new Set([120, 180, 240, 360, 480]);
+const DATE_ONLY_PATTERN = /^\d{4}-\d{2}-\d{2}$/;
+const DAY_MS = 24 * 60 * 60 * 1000;
+
+export interface CrmAvailabilityRequest {
+  startDate: string;
+  endDate: string;
+  duration: number;
+}
+
+export interface CrmAvailabilityResponse {
+  slots: string[];
+}
+
+interface BridgeRequest {
+  method: string;
+  secretHeader?: string;
+  body: unknown;
+}
+
+interface InternalAvailabilityResult {
+  slots: Array<{
+    dateTime: string;
+    isAvailable: boolean;
+    appointmentId?: string;
+  }>;
+}
+
+interface BridgeDependencies {
+  expectedSecret: string;
+  getAvailableSlots: (
+    params: GetAvailableSlotsParams
+  ) => Promise<InternalAvailabilityResult>;
+}
+
+type BridgeResult =
+  | { status: 200; body: CrmAvailabilityResponse }
+  | { status: number; body: { error: string } };
+
+class CrmAvailabilityValidationError extends Error {}
+
+function isRecord(value: unknown): value is Record<string, unknown> {
+  return typeof value === 'object' && value !== null && !Array.isArray(value);
+}
+
+function parseDateKey(value: unknown, field: 'startDate' | 'endDate'): string {
+  if (typeof value !== 'string' || !DATE_ONLY_PATTERN.test(value)) {
+    throw new CrmAvailabilityValidationError(`${field} debe ser YYYY-MM-DD`);
+  }
+  const timestamp = Date.parse(`${value}T00:00:00.000Z`);
+  if (
+    !Number.isFinite(timestamp) ||
+    new Date(timestamp).toISOString().slice(0, 10) !== value
+  ) {
+    throw new CrmAvailabilityValidationError(`${field} no es una fecha v├ílida`);
+  }
+  return value;
+}
+
+export function validateCrmAvailabilityRequest(
+  body: unknown
+): CrmAvailabilityRequest {
+  if (!isRecord(body)) {
+    throw new CrmAvailabilityValidationError('body debe ser un objeto');
+  }
+  if (Object.prototype.hasOwnProperty.call(body, 'serviceId')) {
+    throw new CrmAvailabilityValidationError('serviceId no es seleccionable');
+  }
+  if (Object.prototype.hasOwnProperty.call(body, 'providerId')) {
+    throw new CrmAvailabilityValidationError('providerId no es seleccionable');
+  }
+
+  const startDate = parseDateKey(body.startDate, 'startDate');
+  const endDate = parseDateKey(body.endDate, 'endDate');
+  const duration = body.duration;
+  if (
+    typeof duration !== 'number' ||
+    !Number.isInteger(duration) ||
+    !OFFICIAL_DURATIONS.has(duration)
+  ) {
+    throw new CrmAvailabilityValidationError('duration no es oficial');
+  }
+
+  const startMs = Date.parse(`${startDate}T00:00:00.000Z`);
+  const endMs = Date.parse(`${endDate}T00:00:00.000Z`);
+  if (endMs < startMs) {
+    throw new CrmAvailabilityValidationError('endDate debe ser igual o posterior a startDate');
+  }
+  if ((endMs - startMs) / DAY_MS + 1 > 7) {
+    throw new CrmAvailabilityValidationError('El rango m├íximo es de 7 d├¡as');
+  }
+
+  return { startDate, endDate, duration };
+}
+
+function secretsMatch(provided: string | undefined, expected: string): boolean {
+  if (!provided || !expected) return false;
+  const providedDigest = createHash('sha256').update(provided).digest();
+  const expectedDigest = createHash('sha256').update(expected).digest();
+  return timingSafeEqual(providedDigest, expectedDigest);
+}
+
+function clientErrorStatus(error: HttpsError): number | null {
+  const statusByCode: Partial<Record<HttpsError['code'], number>> = {
+    'invalid-argument': 400,
+    unauthenticated: 401,
+    'permission-denied': 403,
+    'not-found': 404,
+    'failed-precondition': 409,
+    'resource-exhausted': 429,
+  };
+  return statusByCode[error.code] ?? null;
+}
+
+function isIsoDateTime(value: string): boolean {
+  const parsed = new Date(value);
+  return Number.isFinite(parsed.getTime()) && parsed.toISOString() === value;
+}
+
+export async function handleCrmGetAvailableSlots(
+  request: BridgeRequest,
+  dependencies: BridgeDependencies
+): Promise<BridgeResult> {
+  if (request.method.toUpperCase() !== 'POST') {
+    return { status: 405, body: { error: 'method_not_allowed' } };
+  }
+  if (!secretsMatch(request.secretHeader, dependencies.expectedSecret)) {
+    return { status: 401, body: { error: 'unauthorized' } };
+  }
+
+  let params: CrmAvailabilityRequest;
+  try {
+    params = validateCrmAvailabilityRequest(request.body);
+  } catch (error) {
+    if (error instanceof CrmAvailabilityValidationError) {
+      return { status: 400, body: { error: error.message } };
+    }
+    return { status: 400, body: { error: 'invalid_request' } };
+  }
+
+  try {
+    const result = await dependencies.getAvailableSlots({
+      serviceId: PROSAVIS_LIMPIEZA_SERVICE_ID,
+      startDate: params.startDate,
+      endDate: params.endDate,
+      duration: params.duration,
+      checkEntireTeam: true,
+    });
+    const slots = result.slots
+      .filter((slot) => slot.isAvailable && isIsoDateTime(slot.dateTime))
+      .map((slot) => slot.dateTime);
+    return { status: 200, body: { slots } };
+  } catch (error) {
+    if (error instanceof HttpsError) {
+      const status = clientErrorStatus(error);
+      if (status !== null) {
+        return { status, body: { error: error.message } };
+      }
+    }
+    logger.error('[crmGetAvailableSlots] Internal failure', { error });
+    return { status: 500, body: { error: 'internal' } };
+  }
+}
+
+export const crmGetAvailableSlots = onRequest(
+  {
+    region: 'us-central1',
+    secrets: [firebaseCrmBridgeSecret],
+    cors: false,
+  },
+  async (req, res) => {
+    const result = await handleCrmGetAvailableSlots(
+      {
+        method: req.method,
+        secretHeader: req.get('x-crm-secret') ?? undefined,
+        body: req.body,
+      },
+      {
+        expectedSecret: firebaseCrmBridgeSecret.value(),
+        getAvailableSlots: getAvailableSlotsInternal,
+      }
+    );
+    if (result.status === 405) {
+      res.set('Allow', 'POST');
+    }
+    res.status(result.status).json(result.body);
+  }
+);
