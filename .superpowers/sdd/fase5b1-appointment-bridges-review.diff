+import { getFirestore } from 'firebase-admin/firestore';
+import { defineSecret } from 'firebase-functions/params';
+import {
+  CallableRequest,
+  HttpsError,
+  onRequest,
+} from 'firebase-functions/v2/https';
+import {
+  createCrmBridgeIdempotencyRunner,
+  CrmBridgeIdempotencyRunner,
+  FirestoreCrmBridgeActionStore,
+  handleCrmCreateAppointment,
+  handleCrmRescheduleAppointment,
+} from './crmAppointmentBridges';
+import { handleCreateAppointment } from './createAppointment';
+import { handleCrmRescheduleAppointmentCore } from './crmRescheduleAppointment';
+import { resolveAvailableProviderForExactSlot } from './getAvailableSlots';
+
+const CRM_BRIDGE_ACTOR_UID = 'crm-ai-bridge';
+const firebaseCrmBridgeSecret = defineSecret('FIREBASE_CRM_BRIDGE_SECRET');
+const supabaseServiceRoleKey = defineSecret('SUPABASE_SERVICE_ROLE_KEY');
+const googleMapsApiKey = defineSecret('GOOGLE_MAPS_API_KEY');
+
+function syntheticCallableRequest(data: unknown): CallableRequest<unknown> {
+  return {
+    auth: {
+      uid: CRM_BRIDGE_ACTOR_UID,
+      token: {},
+    },
+    data,
+  } as CallableRequest<unknown>;
+}
+
+function productionIdempotencyRunner(): CrmBridgeIdempotencyRunner {
+  return createCrmBridgeIdempotencyRunner(
+    new FirestoreCrmBridgeActionStore(getFirestore())
+  );
+}
+
+export const crmCreateAppointment = onRequest(
+  {
+    region: 'us-central1',
+    secrets: [
+      firebaseCrmBridgeSecret,
+      supabaseServiceRoleKey,
+      googleMapsApiKey,
+    ],
+    cors: false,
+  },
+  async (req, res) => {
+    const result = await handleCrmCreateAppointment(
+      {
+        method: req.method,
+        secretHeader: req.get('x-crm-secret') ?? undefined,
+        body: req.body,
+      },
+      {
+        expectedSecret: firebaseCrmBridgeSecret.value(),
+        runIdempotent: productionIdempotencyRunner(),
+        resolveProvider: resolveAvailableProviderForExactSlot,
+        createAppointment: async ({ data, origin }) =>
+          handleCreateAppointment(syntheticCallableRequest(data), origin),
+      }
+    );
+    if (result.status === 405) res.set('Allow', 'POST');
+    res.status(result.status).json(result.body);
+  }
+);
+
+export const crmRescheduleAppointmentHttp = onRequest(
+  {
+    region: 'us-central1',
+    secrets: [firebaseCrmBridgeSecret, supabaseServiceRoleKey],
+    cors: false,
+  },
+  async (req, res) => {
+    const db = getFirestore();
+    const result = await handleCrmRescheduleAppointment(
+      {
+        method: req.method,
+        secretHeader: req.get('x-crm-secret') ?? undefined,
+        body: req.body,
+      },
+      {
+        expectedSecret: firebaseCrmBridgeSecret.value(),
+        runIdempotent: productionIdempotencyRunner(),
+        getAppointmentContext: async (appointmentId) => {
+          const snapshot = await db
+            .collection('appointments')
+            .doc(appointmentId)
+            .get();
+          if (!snapshot.exists) {
+            throw new HttpsError('not-found', 'Cita no encontrada');
+          }
+          const data = snapshot.data()!;
+          return {
+            serviceId: String(data.serviceId ?? ''),
+            duration: Number(data.duration),
+          };
+        },
+        resolveProvider: resolveAvailableProviderForExactSlot,
+        rescheduleAppointment: async ({ data, origin }) =>
+          handleCrmRescheduleAppointmentCore(
+            syntheticCallableRequest(data),
+            origin
+          ),
+      }
+    );
+    if (result.status === 405) res.set('Allow', 'POST');
+    res.status(result.status).json(result.body);
+  }
+);
