+    [{ ...VALID_RESCHEDULE_BODY, actionId: 'not-v4' }, 'actionId'],
+    [{ ...VALID_RESCHEDULE_BODY, appointmentId: '' }, 'appointmentId'],
+    [{ ...VALID_RESCHEDULE_BODY, scheduledDate: 'not-iso' }, 'scheduledDate'],
+    [{ ...VALID_RESCHEDULE_BODY, providerId: 'invented' }, 'providerId'],
+    [{ ...VALID_RESCHEDULE_BODY, allowPastDate: true }, 'allowPastDate'],
+    [{ ...VALID_RESCHEDULE_BODY, assignedTeamMemberIds: ['invented'] }, 'assignedTeamMemberIds'],
+    [{ ...VALID_RESCHEDULE_BODY, status: 'COMPLETED' }, 'status'],
+    [{ ...VALID_RESCHEDULE_BODY, paymentStatus: 'PAID' }, 'paymentStatus'],
+  ])('rejects invalid or caller-controlled reschedule payload %#', (body, message) => {
+    expect(() => validateCrmRescheduleAppointmentRequest(body)).toThrow(message);
+  });
+});
+
+function createDependencies(
+  runIdempotent: CrmBridgeIdempotencyRunner = jest.fn(
+    async (
+      _actionId: string,
+      _operation: string,
+      _requestHash: string,
