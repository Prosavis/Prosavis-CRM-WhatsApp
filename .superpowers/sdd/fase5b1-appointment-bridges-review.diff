+import { Timestamp } from 'firebase-admin/firestore';
+import { HttpsError } from 'firebase-functions/v2/https';
+import {
+  createCrmBridgeIdempotencyRunner,
+  CrmBridgeActionRecord,
+  CrmBridgeActionStore,
+  CrmBridgeIdempotencyRunner,
+  handleCrmCreateAppointment,
+  handleCrmRescheduleAppointment,
+  validateCrmCreateAppointmentRequest,
+  validateCrmRescheduleAppointmentRequest,
+} from './crmAppointmentBridges';
+import {
+  APPOINTMENT_PRICES_BY_DURATION,
+  PROSAVIS_CLEANING_PROFESSIONAL_KIT_ADDON_COP,
+  PROSAVIS_LIMPIEZA_SERVICE_ID,
+} from '../constants/pricing';
+
+const VALID_CREATE_BODY = {
+  actionId: '123e4567-e89b-42d3-a456-426614174000',
+  clientId: 'client-123',
+  scheduledDate: '2099-08-06T14:00:00.000Z',
+  duration: 240,
+  address: 'Calle 1 # 2-3',
+  wantsKit: false,
+};
+
+const VALID_RESCHEDULE_BODY = {
+  actionId: '223e4567-e89b-42d3-a456-426614174000',
+  appointmentId: 'appointment-123',
+  scheduledDate: '2099-08-07T14:00:00.000Z',
+};
+
+describe('handleCrmCreateAppointment', () => {
+  test('requires POST and the bridge secret before executing dependencies', async () => {
+    const dependencies = createDependencies();
+
+    await expect(
+      handleCrmCreateAppointment(
+        { method: 'GET', secretHeader: 'bridge-secret', body: VALID_CREATE_BODY },
+        dependencies
+      )
+    ).resolves.toEqual({
+      status: 405,
+      body: { error: 'method_not_allowed' },
+    });
+
+    await expect(
+      handleCrmCreateAppointment(
+        { method: 'POST', secretHeader: 'wrong-secret', body: VALID_CREATE_BODY },
+        dependencies
+      )
+    ).resolves.toEqual({
+      status: 401,
+      body: { error: 'unauthorized' },
+    });
+
+    expect(dependencies.createAppointment).not.toHaveBeenCalled();
+    expect(dependencies.resolveProvider).not.toHaveBeenCalled();
+  });
+
+  test('grounds service, price, kit and a real provider before invoking the canonical core once', async () => {
+    const dependencies = createDependencies();
+    dependencies.resolveProvider.mockResolvedValue('provider-real');
+    dependencies.createAppointment.mockResolvedValue({
+      appointmentId: 'appointment-1',
+      status: 'CONFIRMED',
+      availabilityWarnings: [],
+    });
+
+    const result = await handleCrmCreateAppointment(
+      {
+        method: 'POST',
+        secretHeader: 'bridge-secret',
+        body: { ...VALID_CREATE_BODY, wantsKit: true },
+      },
+      dependencies
+    );
+
+    expect(dependencies.resolveProvider).toHaveBeenCalledTimes(1);
+    expect(dependencies.resolveProvider).toHaveBeenCalledWith({
+      serviceId: PROSAVIS_LIMPIEZA_SERVICE_ID,
+      scheduledDate: new Date(VALID_CREATE_BODY.scheduledDate),
+      duration: VALID_CREATE_BODY.duration,
+    });
+    expect(dependencies.createAppointment).toHaveBeenCalledTimes(1);
+    const canonicalRequest = dependencies.createAppointment.mock.calls[0][0];
+    expect(canonicalRequest.origin).toBe('crm_bridge');
+    expect(canonicalRequest.actorUid).toBe('crm-ai-bridge');
+    expect(canonicalRequest.data).toMatchObject({
+      serviceId: PROSAVIS_LIMPIEZA_SERVICE_ID,
+      providerId: 'provider-real',
+      clientId: VALID_CREATE_BODY.clientId,
+      duration: VALID_CREATE_BODY.duration,
+      price:
+        APPOINTMENT_PRICES_BY_DURATION[VALID_CREATE_BODY.duration] +
+        PROSAVIS_CLEANING_PROFESSIONAL_KIT_ADDON_COP,
+      serviceAddress: { addressLine: VALID_CREATE_BODY.address },
+      isConfirmed: true,
+      includeProfessionalKit: true,
+      sourceChannel: 'crm_ai_bridge',
+      assignedVia: 'auto',
+    });
+    expect(canonicalRequest.data.scheduledDate).toBeInstanceOf(Timestamp);
+    expect(result).toEqual({
+      status: 200,
+      body: {
+        success: true,
+        appointmentId: 'appointment-1',
+        status: 'CONFIRMED',
+        availabilityWarnings: [],
+      },
+    });
+  });
+
+  test('returns the persisted result for sequential and concurrent retries without repeating the core', async () => {
+    const store = new MemoryActionStore();
+    const runner = createCrmBridgeIdempotencyRunner(store, {
+      pollIntervalMs: 1,
+      waitTimeoutMs: 1000,
+    });
+    const dependencies = createDependencies(runner);
+    dependencies.resolveProvider.mockResolvedValue('provider-real');
+    dependencies.createAppointment.mockImplementation(async () => {
+      await new Promise((resolve) => setTimeout(resolve, 20));
+      return {
+        appointmentId: 'appointment-idempotent',
+        status: 'CONFIRMED',
+        availabilityWarnings: [],
+      };
+    });
+    const request = {
+      method: 'POST',
+      secretHeader: 'bridge-secret',
+      body: VALID_CREATE_BODY,
+    };
+
+    const [first, concurrent] = await Promise.all([
+      handleCrmCreateAppointment(request, dependencies),
+      handleCrmCreateAppointment(request, dependencies),
+    ]);
+    const sequential = await handleCrmCreateAppointment(request, dependencies);
+
+    expect(first).toEqual(concurrent);
+    expect(sequential).toEqual(first);
+    expect(dependencies.createAppointment).toHaveBeenCalledTimes(1);
+    expect(dependencies.resolveProvider).toHaveBeenCalledTimes(1);
+  });
+
+  test('rejects actionId reuse with another payload and persists an unequivocal failed state', async () => {
+    const store = new MemoryActionStore();
+    const runner = createCrmBridgeIdempotencyRunner(store, {
+      pollIntervalMs: 1,
+      waitTimeoutMs: 100,
+    });
+    const dependencies = createDependencies(runner);
+    dependencies.resolveProvider.mockResolvedValue('provider-real');
+    dependencies.createAppointment.mockRejectedValue(
+      new Error('sensitive canonical failure')
+    );
+    const request = {
+      method: 'POST',
+      secretHeader: 'bridge-secret',
+      body: VALID_CREATE_BODY,
+    };
+
+    await expect(
+      handleCrmCreateAppointment(request, dependencies)
+    ).resolves.toEqual({
+      status: 500,
+      body: { error: 'internal' },
+    });
+    await expect(
+      handleCrmCreateAppointment(request, dependencies)
+    ).resolves.toEqual({
+      status: 409,
+      body: { error: 'action_failed' },
+    });
+    await expect(
+      handleCrmCreateAppointment(
+        {
+          ...request,
+          body: { ...VALID_CREATE_BODY, address: 'Otra direcci├│n' },
+        },
+        dependencies
+      )
+    ).resolves.toEqual({
+      status: 409,
+      body: { error: 'action_conflict' },
+    });
+    expect(dependencies.createAppointment).toHaveBeenCalledTimes(1);
+  });
+});
