+}
+
+class MemoryActionStore implements CrmBridgeActionStore {
+  private readonly records = new Map<string, CrmBridgeActionRecord>();
+
+  async get(actionId: string): Promise<CrmBridgeActionRecord | null> {
+    return this.records.get(actionId) ?? null;
+  }
+
+  async createIfAbsent(
+    actionId: string,
+    record: CrmBridgeActionRecord
+  ): Promise<boolean> {
+    if (this.records.has(actionId)) return false;
+    this.records.set(actionId, record);
+    return true;
+  }
+
+  async setIfLease(
+    actionId: string,
+    leaseToken: string,
+    record: CrmBridgeActionRecord
+  ): Promise<boolean> {
+    const current = this.records.get(actionId);
+    if (!current || current.leaseToken !== leaseToken) return false;
+    this.records.set(actionId, record);
+    return true;
+  }
+}
+
+function createRescheduleDependencies(
+  runIdempotent: CrmBridgeIdempotencyRunner = jest.fn(
+    async (
+      _actionId: string,
+      _operation: string,
+      _requestHash: string,
+      action: () => Promise<unknown>
+    ) => action()
