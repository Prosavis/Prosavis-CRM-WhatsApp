@@ -0,0 +1,631 @@
+import { createHash, randomUUID } from 'crypto';
+import {
+  Firestore,
+  Timestamp,
+} from 'firebase-admin/firestore';
+import { logger } from 'firebase-functions/v2';
+import { HttpsError } from 'firebase-functions/v2/https';
+import {
+  APPOINTMENT_PRICES_BY_DURATION,
+  PROSAVIS_CLEANING_PROFESSIONAL_KIT_ADDON_COP,
+  PROSAVIS_LIMPIEZA_SERVICE_ID,
+} from '../constants/pricing';
+import {
+  crmBridgeClientErrorStatus,
+  crmBridgeSecretsMatch,
+  CrmBridgeHttpResult,
+  CrmBridgeRequest,
+} from './crmBridgeHttp';
+
+const CRM_BRIDGE_ACTOR_UID = 'crm-ai-bridge';
+const CRM_BRIDGE_ACTIONS_COLLECTION = '_crm_bridge_actions';
+const OFFICIAL_DURATIONS = new Set([120, 180, 240, 360, 480]);
+const UUID_V4_PATTERN =
+  /^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/i;
+const CREATE_FIELDS = new Set([
+  'actionId',
+  'clientId',
+  'scheduledDate',
+  'duration',
+  'address',
+  'wantsKit',
+]);
+const RESCHEDULE_FIELDS = new Set([
+  'actionId',
+  'appointmentId',
+  'scheduledDate',
+]);
+
+export interface CrmBridgeActionRecord {
+  operation: string;
+  requestHash: string;
+  status: 'processing' | 'completed' | 'failed';
+  createdAtMs: number;
+  updatedAtMs: number;
+  leaseToken?: string;
+  result?: unknown;
+}
+export interface CrmBridgeActionStore {
+  get(actionId: string): Promise<CrmBridgeActionRecord | null>;
+  createIfAbsent(
+    actionId: string,
+    record: CrmBridgeActionRecord
+  ): Promise<boolean>;
+  setIfLease(
+    actionId: string,
+    leaseToken: string,
+    record: CrmBridgeActionRecord
+  ): Promise<boolean>;
+}
+
+export class FirestoreCrmBridgeActionStore implements CrmBridgeActionStore {
+  constructor(private readonly db: Firestore) {}
+
+  async get(actionId: string): Promise<CrmBridgeActionRecord | null> {
+    const snapshot = await this.db
+      .collection(CRM_BRIDGE_ACTIONS_COLLECTION)
+      .doc(actionId)
+      .get();
+    if (!snapshot.exists) return null;
+    return snapshot.data() as CrmBridgeActionRecord;
+  }
+
+  async createIfAbsent(
+    actionId: string,
+    record: CrmBridgeActionRecord
+  ): Promise<boolean> {
+    const ref = this.db
+      .collection(CRM_BRIDGE_ACTIONS_COLLECTION)
+      .doc(actionId);
+    return this.db.runTransaction(async (transaction) => {
+      const snapshot = await transaction.get(ref);
+      if (snapshot.exists) return false;
+      transaction.set(ref, record);
+      return true;
+    });
+  }
+
+  async setIfLease(
+    actionId: string,
+    leaseToken: string,
+    record: CrmBridgeActionRecord
+  ): Promise<boolean> {
+    const ref = this.db
+      .collection(CRM_BRIDGE_ACTIONS_COLLECTION)
+      .doc(actionId);
+    return this.db.runTransaction(async (transaction) => {
+      const snapshot = await transaction.get(ref);
+      if (!snapshot.exists || snapshot.data()?.leaseToken !== leaseToken) {
+        return false;
+      }
+      transaction.set(ref, record);
+      return true;
+    });
+  }
+}
+
+interface CrmBridgeIdempotencyOptions {
+  pollIntervalMs?: number;
+  waitTimeoutMs?: number;
+}
+
+export type CrmBridgeIdempotencyRunner = (
+  actionId: string,
+  operation: string,
+  requestHash: string,
+  action: () => Promise<unknown>
+) => Promise<unknown>;
+
+export interface CrmCreateAppointmentRequest {
+  actionId: string;
+  clientId: string;
+  scheduledDate: string;
+  duration: number;
+  address: string;
+  wantsKit: boolean;
+}
+
+interface CanonicalCreateAppointmentRequest {
+  actorUid: string;
+  origin: 'crm_bridge';
+  data: {
+    serviceId: string;
+    serviceTitle: string;
+    providerId: string;
+    clientId: string;
+    scheduledDate: Timestamp;
+    duration: number;
+    price: number;
+    serviceAddress: { addressLine: string };
+    notes: string;
+    isConfirmed: true;
+    includeProfessionalKit: boolean;
+    sourceChannel: string;
+    assignedVia: string;
+  };
+}
+
+interface CanonicalCreateAppointmentResult {
+  appointmentId: string;
+  status: string;
+  availabilityWarnings?: unknown[];
+}
+
+export interface CrmRescheduleAppointmentRequest {
+  actionId: string;
+  appointmentId: string;
+  scheduledDate: string;
+}
+
+interface CanonicalRescheduleAppointmentRequest {
+  actorUid: string;
+  origin: 'crm_bridge';
+  data: {
+    appointmentId: string;
+    scheduledDate: Timestamp;
+    providerId: string;
+    reason: string;
+  };
+}
+
+interface CanonicalRescheduleAppointmentResult {
+  success: boolean;
+  appointmentId: string;
+  availabilityWarnings?: unknown[];
+}
+
+export interface CrmRescheduleAppointmentResponse {
+  success: true;
+  appointmentId: string;
+  availabilityWarnings: unknown[];
+}
+
+export interface CrmCreateAppointmentResponse {
+  success: true;
+  appointmentId: string;
+  status: string;
+  availabilityWarnings: unknown[];
+}
+
+interface CrmCreateBridgeDependencies {
+  expectedSecret: string;
+  runIdempotent: (
+    actionId: string,
+    operation: string,
+    requestHash: string,
+    action: () => Promise<CrmCreateAppointmentResponse>
+  ) => Promise<unknown>;
+  resolveProvider: (params: {
+    serviceId: string;
+    scheduledDate: Date;
+    duration: number;
+  }) => Promise<string>;
+  createAppointment: (
+    request: CanonicalCreateAppointmentRequest
+  ) => Promise<CanonicalCreateAppointmentResult>;
+}
+
+interface CrmRescheduleBridgeDependencies {
+  expectedSecret: string;
+  runIdempotent: CrmBridgeIdempotencyRunner;
+  getAppointmentContext: (appointmentId: string) => Promise<{
+    serviceId: string;
+    duration: number;
+  }>;
+  resolveProvider: (params: {
+    serviceId: string;
+    scheduledDate: Date;
+    duration: number;
+    excludeAppointmentId: string;
+  }) => Promise<string>;
+  rescheduleAppointment: (
+    request: CanonicalRescheduleAppointmentRequest
+  ) => Promise<CanonicalRescheduleAppointmentResult>;
+}
+
+class CrmAppointmentValidationError extends Error {}
+
+function assertMatchingAction(
+  record: CrmBridgeActionRecord,
+  operation: string,
+  requestHash: string
+): void {
+  if (
+    record.operation !== operation ||
+    record.requestHash !== requestHash
+  ) {
+    throw new HttpsError('failed-precondition', 'action_conflict');
+  }
+}
+
+function resultFromSettledAction(record: CrmBridgeActionRecord): unknown {
+  if (record.status === 'completed') return record.result;
+  if (record.status === 'failed') {
+    throw new HttpsError('failed-precondition', 'action_failed');
+  }
+  return undefined;
+}
+
+async function waitForSettledAction(
+  store: CrmBridgeActionStore,
+  actionId: string,
+  operation: string,
+  requestHash: string,
+  pollIntervalMs: number,
+  waitTimeoutMs: number
+): Promise<unknown> {
+  const deadline = Date.now() + waitTimeoutMs;
+  while (Date.now() < deadline) {
+    await new Promise((resolve) => setTimeout(resolve, pollIntervalMs));
+    const current = await store.get(actionId);
+    if (!current) {
+      throw new HttpsError('internal', 'action_state_missing');
+    }
+    assertMatchingAction(current, operation, requestHash);
+    if (current.status !== 'processing') {
+      return resultFromSettledAction(current);
+    }
+  }
+  throw new HttpsError('failed-precondition', 'action_state_unknown');
+}
+
+export function createCrmBridgeIdempotencyRunner(
+  store: CrmBridgeActionStore,
+  options: CrmBridgeIdempotencyOptions = {}
+): CrmBridgeIdempotencyRunner {
+  const pollIntervalMs = options.pollIntervalMs ?? 100;
+  const waitTimeoutMs = options.waitTimeoutMs ?? 30_000;
+
+  return async (actionId, operation, requestHash, action) => {
+    const nowMs = Date.now();
+    const leaseToken = randomUUID();
+    const processingRecord: CrmBridgeActionRecord = {
+      operation,
+      requestHash,
+      status: 'processing',
+      createdAtMs: nowMs,
+      updatedAtMs: nowMs,
+      leaseToken,
+    };
+    const acquired = await store.createIfAbsent(actionId, processingRecord);
+
+    if (!acquired) {
+      const existing = await store.get(actionId);
+      if (!existing) {
+        throw new HttpsError('internal', 'action_state_missing');
+      }
+      assertMatchingAction(existing, operation, requestHash);
+      if (existing.status !== 'processing') {
+        return resultFromSettledAction(existing);
+      }
+      return waitForSettledAction(
+        store,
+        actionId,
+        operation,
+        requestHash,
+        pollIntervalMs,
+        waitTimeoutMs
+      );
+    }
+
+    try {
+      const result = await action();
+      const completed = await store.setIfLease(actionId, leaseToken, {
+        operation,
+        requestHash,
+        status: 'completed',
+        createdAtMs: nowMs,
+        updatedAtMs: Date.now(),
+        result,
+      });
+      if (!completed) {
+        throw new HttpsError('internal', 'action_lease_lost');
+      }
+      return result;
+    } catch (error) {
+      await store.setIfLease(actionId, leaseToken, {
+        operation,
+        requestHash,
+        status: 'failed',
+        createdAtMs: nowMs,
+        updatedAtMs: Date.now(),
+      });
+      throw error;
+    }
+  };
+}
+
+function isRecord(value: unknown): value is Record<string, unknown> {
+  return typeof value === 'object' && value !== null && !Array.isArray(value);
+}
+
+function assertOnlyFields(
+  body: Record<string, unknown>,
+  allowedFields: ReadonlySet<string>
+): void {
+  const forbidden = Object.keys(body).find((field) => !allowedFields.has(field));
+  if (forbidden) {
+    throw new CrmAppointmentValidationError(
+      `${forbidden} no es controlable por caller`
+    );
+  }
+}
+
+function parseBoundedId(value: unknown, field: string): string {
+  if (typeof value !== 'string') {
+    throw new CrmAppointmentValidationError(`${field} debe ser string`);
+  }
+  const trimmed = value.trim();
+  if (!trimmed || trimmed.length > 128 || trimmed.includes('/')) {
+    throw new CrmAppointmentValidationError(`${field} no es v├ílido`);
+  }
+  return trimmed;
+}
+
+function parseCanonicalFutureIso(value: unknown): string {
+  if (typeof value !== 'string') {
+    throw new CrmAppointmentValidationError(
+      'scheduledDate debe ser ISO datetime'
+    );
+  }
+  const parsed = new Date(value);
+  if (!Number.isFinite(parsed.getTime()) || parsed.toISOString() !== value) {
+    throw new CrmAppointmentValidationError(
+      'scheduledDate debe ser ISO datetime can├│nico'
+    );
+  }
+  if (parsed.getTime() <= Date.now()) {
+    throw new CrmAppointmentValidationError(
+      'scheduledDate debe estar en el futuro'
+    );
+  }
+  return value;
+}
+
+export function validateCrmCreateAppointmentRequest(
+  body: unknown
+): CrmCreateAppointmentRequest {
+  if (!isRecord(body)) {
+    throw new CrmAppointmentValidationError('body debe ser un objeto');
+  }
+  assertOnlyFields(body, CREATE_FIELDS);
+
+  const actionId = parseBoundedId(body.actionId, 'actionId');
+  if (!UUID_V4_PATTERN.test(actionId)) {
+    throw new CrmAppointmentValidationError('actionId debe ser UUID v4');
+  }
+  const clientId = parseBoundedId(body.clientId, 'clientId');
+  const scheduledDate = parseCanonicalFutureIso(body.scheduledDate);
+  const duration = body.duration;
+  if (
+    typeof duration !== 'number' ||
+    !Number.isInteger(duration) ||
+    !OFFICIAL_DURATIONS.has(duration)
+  ) {
+    throw new CrmAppointmentValidationError('duration no es oficial');
+  }
+  if (typeof body.address !== 'string') {
+    throw new CrmAppointmentValidationError('address debe ser string');
+  }
+  const address = body.address.trim();
+  if (!address || address.length > 500) {
+    throw new CrmAppointmentValidationError('address no es v├ílida');
+  }
+  if (typeof body.wantsKit !== 'boolean') {
+    throw new CrmAppointmentValidationError('wantsKit debe ser boolean');
+  }
+
+  return {
+    actionId,
+    clientId,
+    scheduledDate,
+    duration,
+    address,
+    wantsKit: body.wantsKit,
+  };
+}
+
+export function validateCrmRescheduleAppointmentRequest(
+  body: unknown
+): CrmRescheduleAppointmentRequest {
+  if (!isRecord(body)) {
+    throw new CrmAppointmentValidationError('body debe ser un objeto');
+  }
+  assertOnlyFields(body, RESCHEDULE_FIELDS);
+
+  const actionId = parseBoundedId(body.actionId, 'actionId');
+  if (!UUID_V4_PATTERN.test(actionId)) {
+    throw new CrmAppointmentValidationError('actionId debe ser UUID v4');
+  }
+  const appointmentId = parseBoundedId(body.appointmentId, 'appointmentId');
+  const scheduledDate = parseCanonicalFutureIso(body.scheduledDate);
+  return { actionId, appointmentId, scheduledDate };
+}
+
+function hashCreateRequest(params: CrmCreateAppointmentRequest): string {
+  return createHash('sha256')
+    .update(JSON.stringify(params))
+    .digest('hex');
+}
+
+function hashRescheduleRequest(
+  params: CrmRescheduleAppointmentRequest
+): string {
+  return createHash('sha256')
+    .update(JSON.stringify(params))
+    .digest('hex');
+}
+
+export async function handleCrmCreateAppointment(
+  request: CrmBridgeRequest,
+  dependencies: CrmCreateBridgeDependencies
+): Promise<CrmBridgeHttpResult<CrmCreateAppointmentResponse>> {
+  if (request.method.toUpperCase() !== 'POST') {
+    return { status: 405, body: { error: 'method_not_allowed' } };
+  }
+  if (!crmBridgeSecretsMatch(request.secretHeader, dependencies.expectedSecret)) {
+    return { status: 401, body: { error: 'unauthorized' } };
+  }
+
+  let params: CrmCreateAppointmentRequest;
+  try {
+    params = validateCrmCreateAppointmentRequest(request.body);
+  } catch (error) {
+    if (error instanceof CrmAppointmentValidationError) {
+      return { status: 400, body: { error: error.message } };
+    }
+    return { status: 400, body: { error: 'invalid_request' } };
+  }
+
+  try {
+    const result = await dependencies.runIdempotent(
+      params.actionId,
+      'create_appointment',
+      hashCreateRequest(params),
+      async () => {
+        const scheduledDate = new Date(params.scheduledDate);
+        const providerId = await dependencies.resolveProvider({
+          serviceId: PROSAVIS_LIMPIEZA_SERVICE_ID,
+          scheduledDate,
+          duration: params.duration,
+        });
+        const officialPrice =
+          APPOINTMENT_PRICES_BY_DURATION[params.duration] +
+          (params.wantsKit
+            ? PROSAVIS_CLEANING_PROFESSIONAL_KIT_ADDON_COP
+            : 0);
+        const canonicalResult = await dependencies.createAppointment({
+          actorUid: CRM_BRIDGE_ACTOR_UID,
+          origin: 'crm_bridge',
+          data: {
+            serviceId: PROSAVIS_LIMPIEZA_SERVICE_ID,
+            serviceTitle: 'Prosavis Limpieza',
+            providerId,
+            clientId: params.clientId,
+            scheduledDate: Timestamp.fromDate(scheduledDate),
+            duration: params.duration,
+            price: officialPrice,
+            serviceAddress: { addressLine: params.address },
+            notes: 'Creada desde CRM Inbox IA tras confirmaci├│n humana',
+            isConfirmed: true,
+            includeProfessionalKit: params.wantsKit,
+            sourceChannel: 'crm_ai_bridge',
+            assignedVia: 'auto',
+          },
+        });
+        return {
+          success: true,
+          appointmentId: canonicalResult.appointmentId,
+          status: canonicalResult.status,
+          availabilityWarnings:
+            canonicalResult.availabilityWarnings ?? [],
+        };
+      }
+    );
+    return {
+      status: 200,
+      body: result as CrmCreateAppointmentResponse,
+    };
+  } catch (error) {
+    if (error instanceof HttpsError) {
+      const status = crmBridgeClientErrorStatus(error);
+      if (status !== null) {
+        return { status, body: { error: error.message } };
+      }
+    }
+    logger.error('[crmCreateAppointment] Internal failure', {
+      actionId: params.actionId,
+      errorType: error instanceof Error ? error.name : typeof error,
+    });
+    return { status: 500, body: { error: 'internal' } };
+  }
+}
+
+export async function handleCrmRescheduleAppointment(
+  request: CrmBridgeRequest,
+  dependencies: CrmRescheduleBridgeDependencies
+): Promise<CrmBridgeHttpResult<CrmRescheduleAppointmentResponse>> {
+  if (request.method.toUpperCase() !== 'POST') {
+    return { status: 405, body: { error: 'method_not_allowed' } };
+  }
+  if (!crmBridgeSecretsMatch(request.secretHeader, dependencies.expectedSecret)) {
+    return { status: 401, body: { error: 'unauthorized' } };
+  }
+
+  let params: CrmRescheduleAppointmentRequest;
+  try {
+    params = validateCrmRescheduleAppointmentRequest(request.body);
+  } catch (error) {
+    if (error instanceof CrmAppointmentValidationError) {
+      return { status: 400, body: { error: error.message } };
+    }
+    return { status: 400, body: { error: 'invalid_request' } };
+  }
+
+  try {
+    const result = await dependencies.runIdempotent(
+      params.actionId,
+      'reschedule_appointment',
+      hashRescheduleRequest(params),
+      async () => {
+        const appointment = await dependencies.getAppointmentContext(
+          params.appointmentId
+        );
+        if (appointment.serviceId !== PROSAVIS_LIMPIEZA_SERVICE_ID) {
+          throw new HttpsError(
+            'failed-precondition',
+            'La cita no pertenece al servicio oficial'
+          );
+        }
+        if (!OFFICIAL_DURATIONS.has(appointment.duration)) {
+          throw new HttpsError(
+            'failed-precondition',
+            'La cita no tiene una duraci├│n oficial'
+          );
+        }
+        const scheduledDate = new Date(params.scheduledDate);
+        const providerId = await dependencies.resolveProvider({
+          serviceId: appointment.serviceId,
+          scheduledDate,
+          duration: appointment.duration,
+          excludeAppointmentId: params.appointmentId,
+        });
+        const canonicalResult = await dependencies.rescheduleAppointment({
+          actorUid: CRM_BRIDGE_ACTOR_UID,
+          origin: 'crm_bridge',
+          data: {
+            appointmentId: params.appointmentId,
+            scheduledDate: Timestamp.fromDate(scheduledDate),
+            providerId,
+            reason:
+              'Reagendada desde CRM Inbox IA tras confirmaci├│n humana',
+          },
+        });
+        return {
+          success: true,
+          appointmentId: canonicalResult.appointmentId,
+          availabilityWarnings:
+            canonicalResult.availabilityWarnings ?? [],
+        };
+      }
+    );
+    return {
+      status: 200,
+      body: result as CrmRescheduleAppointmentResponse,
+    };
+  } catch (error) {
+    if (error instanceof HttpsError) {
+      const status = crmBridgeClientErrorStatus(error);
+      if (status !== null) {
+        return { status, body: { error: error.message } };
+      }
+    }
+    logger.error('[crmRescheduleAppointmentHttp] Internal failure', {
+      actionId: params.actionId,
+      appointmentId: params.appointmentId,
+      errorType: error instanceof Error ? error.name : typeof error,
+    });
+    return { status: 500, body: { error: 'internal' } };
+  }
+}
+
diff --git a/functions/src/calendar/crmBridgeHttp.ts b/functions/src/calendar/crmBridgeHttp.ts
new file mode 100644
index 0000000..9ed94cc
--- /dev/null
+++ b/functions/src/calendar/crmBridgeHttp.ts
@@ -0,0 +1,36 @@
+import { createHash, timingSafeEqual } from 'crypto';
+import { HttpsError } from 'firebase-functions/v2/https';
+
+export interface CrmBridgeRequest {
+  method: string;
+  secretHeader?: string;
+  body: unknown;
+}
+
+export type CrmBridgeHttpResult<T> =
+  | { status: 200; body: T }
+  | { status: number; body: { error: string } };
+
+export function crmBridgeSecretsMatch(
+  provided: string | undefined,
+  expected: string
+): boolean {
+  if (!provided || !expected) return false;
+  const providedDigest = createHash('sha256').update(provided).digest();
+  const expectedDigest = createHash('sha256').update(expected).digest();
+  return timingSafeEqual(providedDigest, expectedDigest);
