+) {
+  return {
+    expectedSecret: 'bridge-secret',
+    runIdempotent,
+    getAppointmentContext: jest.fn(),
+    resolveProvider: jest.fn(),
+    rescheduleAppointment: jest.fn(),
+  };
+}
