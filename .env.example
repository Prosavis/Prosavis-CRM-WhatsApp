# Variables publicas del frontend (Vercel / .env.local). Prefijo VITE_ obligatorio.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=your-local-or-remote-publishable-key
VITE_WHATSAPP_PHONE_NUMBER_ID=
VITE_WHATSAPP_WABA_ID=
VITE_WHATSAPP_PHONE_DISPLAY=
VITE_WHATSAPP_BOT_LABEL=
VITE_WHATSAPP_COMMERCIAL_PHONE_NUMBER_ID=1043086062223440
VITE_WHATSAPP_COMMERCIAL_WABA_ID=1680332820009096
VITE_WHATSAPP_COMMERCIAL_PHONE_DISPLAY=+57 311 212 1108
VITE_WHATSAPP_COMMERCIAL_LABEL=Comercial 311

# Firebase (para códigos de descuento compartidos con el Panel)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Secrets de Edge Functions: configurar en Supabase Dashboard > Edge Functions > Secrets
# o con: npx supabase secrets set --project-ref djzwjaegxbhlefanmmee NAME=value
